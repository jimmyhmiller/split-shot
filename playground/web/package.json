{
  "name": "partial-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "cd ../wasm && wasm-pack build --release --target web --out-dir ../web/src/pkg",
    "dev": "vite",
